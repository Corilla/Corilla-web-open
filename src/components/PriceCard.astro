---
interface Props {
  id?: string;
  name: string;
  description: string;
  price: string;
  frequency: string;
  featuresLabel: string;
  features: string[];
  ctaText: string;
  ctaHref: string;
  badge?: string;
  highlight?: boolean;
}

const { id, name, description, price, frequency, featuresLabel, features, ctaText, ctaHref, badge, highlight = false } = Astro.props;
---

<div id={id} class:list={['price-option', { 'is-highlighted': highlight }]}>
  {badge && <div class="badge">{badge}</div>}
  <div class="description">
    <h3>{name}</h3>
    <p>{description}</p>
    <div class="price">
      <span class="currency">$</span>
      <span class="price-number">{price}</span>
      <span class="frequency" set:html={frequency} />
    </div>
    <h4>{featuresLabel}</h4>
    <p></p>
    <ul>
      {features.map((f) => <li>{f}</li>)}
    </ul>
  </div>
  <a class:list={['button', { 'button-highlight': highlight }]} href={ctaHref}>{ctaText}</a>
</div>

<style>
  .price-option {
    padding: 1.25em 1em 1em;
    border: 2px solid #E5E9EC;
    background: #FFFFFF;
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    text-align: center;
    width: 19em;
    border-radius: 10px;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .price-option:hover {
    border-color: #B4C0C8;
    box-shadow: 0 12px 24px -8px rgba(11, 44, 62, 0.08);
  }

  .price-option.is-highlighted {
    border: 2px solid #F7D33A;
    box-shadow: 0 16px 32px -8px rgba(247, 211, 58, 0.25), 0 4px 12px rgba(11, 44, 62, 0.05);
    transform: translateY(-4px);
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #0B2C3E;
    color: #F7D33A;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.25em 0.85em;
    border-radius: 12px;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .price-option + :global(.price-option) {
    margin-left: 2em;
  }

  .description {
    padding-top: 2em;
    font-size: 0.9em;
  }

  .description h3 {
    padding-bottom: 0.5em;
  }

  .description p {
    color: #5F6F78;
    width: 95%;
    margin: auto;
    display: block;
    padding-bottom: 2em;
    font-size: 0.9em;
  }

  .price {
    padding-bottom: 2em;
    padding-left: 2em;
  }

  .currency {
    display: inline-block;
    vertical-align: top;
    font-size: 1.25rem;
    padding-top: 0.4em;
    padding-right: 0.2em;
  }

  .price-number {
    display: inline-block;
    vertical-align: baseline;
    font-size: 3.052rem;
    font-family: 'Sailec-Medium', 'HelveticaNeue', Helvetica, Arial, sans-serif;
  }

  .frequency {
    display: inline-block;
    vertical-align: baseline;
    text-align: left;
    color: #5F6F78;
    font-size: 0.8em;
    padding-left: 0.3em;
  }

  ul {
    padding-bottom: 2em;
    list-style: none;
    margin: 0;
    padding-left: 0;
    padding-bottom: 2em;
  }

  li {
    padding-bottom: 1em;
  }

  .button {
    display: block;
    width: 100%;
    font-size: 1rem;
    background: #F7D33A;
    padding: 0.5em 1em;
    padding-bottom: 0.4em;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
    font-family: 'Sailec-Medium', 'HelveticaNeue', Helvetica, Arial, sans-serif;
  }

  .button:hover {
    background: #0B2C3E;
    color: #fff;
  }

  @media screen and (max-width: 1210px) {
    .price-option {
      width: 17em;
    }
  }
</style>
