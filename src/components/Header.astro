---
interface Props {
  variant?: 'home' | 'default';
}

const { variant = 'default' } = Astro.props;
const isHome = variant === 'home';
---

<div class="header-placeholder" class:list={[{ 'home-bg': isHome }]}></div>
<header class="not-active" class:list={[{ 'home-bg': isHome }]}>
  <div class="header-content">
    <a class="logo" href="/" title="Corilla">
      <img alt="Corilla" src="/assets/img/corilla-logo-text.svg" width="180" height="64" />
    </a>
    <button class="open-menu" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav>
      <ul>
        <li><a class="features" title="Explore our Features" href={isHome ? '#features' : '/#features'}>Features</a></li>
        <li><a class="pricing" title="Pricing" href={isHome ? '#pricing' : '/#pricing'}>Pricing</a></li>
        <li><a href="/about" title="About our Team">Our Story</a></li>
        <li class="login"><a href="https://app.corilla.com/" title="Log in">Log in</a></li>
        <li class="sign-up"><a href="https://app.corilla.com/register" title="Sign Up">Sign up for free</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Sticky header
  const header = document.querySelector('header');
  const stickyHandler = () => {
    if (window.scrollY >= 60) {
      header?.classList.add('is-sticky');
    } else {
      header?.classList.remove('is-sticky');
    }
  };
  window.addEventListener('scroll', stickyHandler, { passive: true });
  stickyHandler();

  // Mobile menu toggle
  const menuBtn = document.querySelector('.open-menu');
  menuBtn?.addEventListener('click', () => {
    header?.classList.toggle('is-open');
  });
</script>

<style>
  .header-placeholder {
    height: 6em;
    width: 100%;
    background: #fff;
  }

  .home-bg {
    background: #fdfefe;
  }

  header {
    background: #fff;
    position: fixed;
    z-index: 100;
    width: 100%;
    top: 0;
  }

  header.home-bg {
    background: #fdfefe;
  }

  .header-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 1em 2em;
    position: relative;
    max-width: 1400px;
    margin: auto;
    width: 100%;
    transition: padding 0.3s ease;
  }

  @media screen and (max-width: 820px) {
    .header-content {
      padding-bottom: 0.5em;
    }
  }

  .header-content img {
    height: 4em;
    transition: height 0.3s ease;
    vertical-align: top;
  }

  .open-menu {
    width: 2.5em;
    height: 2.5em;
    outline: 0;
    cursor: pointer;
    background: 0;
    border: 0;
    transform: rotate(0deg);
    transition: 0.5s ease-in-out;
    display: none;
    position: relative;
  }

  @media screen and (max-width: 820px) {
    .open-menu {
      display: block;
    }
  }

  .open-menu span {
    display: block;
    position: absolute;
    height: 0.25em;
    width: 100%;
    background: #0B2C3E;
    border-radius: 0.25rem;
    opacity: 1;
    left: 0;
    transform: rotate(0deg);
    transition: 0.25s ease-in-out;
  }

  .open-menu span:nth-child(1) {
    top: 0;
  }

  .open-menu span:nth-child(2),
  .open-menu span:nth-child(3) {
    top: 0.75rem;
  }

  .open-menu span:nth-child(4) {
    top: 1.5rem;
  }

  nav ul {
    display: flex;
    flex-direction: row;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav ul li a:hover {
    box-shadow: 0 2px 0;
  }

  nav ul li + li {
    margin-left: 2em;
  }

  nav ul li.login {
    background: #0B2C3E;
  }

  nav ul li.login a {
    color: #fff;
  }

  nav ul li.login a:hover {
    box-shadow: 0 1.5px 0;
  }

  nav ul li.sign-up {
    margin-left: 0;
    background: #F7D33A;
  }

  nav ul li.login,
  nav ul li.sign-up {
    padding: 0.7em 1.2em;
    padding-bottom: 0.6em;
    transition: padding 0.3s ease;
  }

  @media screen and (max-width: 820px) {
    nav {
      position: absolute;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      display: block;
      top: 5.5em;
      width: 100%;
      background: #fff;
      padding: 1em 2em;
      left: 0;
      box-shadow: 0 6px 10px rgba(0, 0, 0, 0.1);
    }

    nav ul {
      display: block;
    }

    nav ul li {
      display: block;
      padding: 1em 0;
    }

    nav ul li + li {
      margin-left: 0;
    }
  }

  /* Sticky state */
  header.is-sticky {
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
  }

  header.is-sticky .header-content {
    padding-top: 0.5em;
    padding-bottom: 0.5em;
  }

  header.is-sticky .header-content img {
    height: 2.5em;
  }

  header.is-sticky nav {
    top: 3.5em;
  }

  header.is-sticky nav ul li.sign-up,
  header.is-sticky nav ul li.login {
    padding-top: 0.6em;
    padding-bottom: 0.4em;
  }

  /* Open state (hamburger animation) */
  header.is-open .open-menu span:nth-child(1) {
    top: 0.75em;
    width: 0%;
    left: 50%;
  }

  header.is-open .open-menu span:nth-child(2) {
    transform: rotate(45deg);
  }

  header.is-open .open-menu span:nth-child(3) {
    transform: rotate(-45deg);
  }

  header.is-open .open-menu span:nth-child(4) {
    top: 0.75em;
    width: 0%;
    left: 50%;
  }

  @media screen and (max-width: 820px) {
    header.is-open nav {
      transition: top 0.3s ease, transform 0.3s ease;
      transform: translateX(0);
    }
  }
</style>
