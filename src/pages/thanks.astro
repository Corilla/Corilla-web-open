---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout bodyClass="contact">
  <section id="intro">
    <div class="section-content">
      <div class="intro-text">
        <h2>Thanks for reaching out to us, we'll get back to you in no time.</h2>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #intro {
    padding: 8em 0;
    text-align: center;
  }

  .section-content {
    width: 85%;
    max-width: 1200px;
    margin: auto;
  }

  .intro-text {
    max-width: 700px;
    margin: auto;
  }
</style>
