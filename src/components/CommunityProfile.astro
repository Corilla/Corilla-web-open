---
interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;
---

<div class="community-profile">
  <h3 class="community-name">{name}</h3>
  <p>{description}</p>
</div>

<style>
  .community-profile {
    text-align: left;
    width: 19em;
    padding-bottom: 4em;
    margin-left: 2em;
  }

  .community-name {
    font-size: 1.25rem;
    font-weight: 500;
    padding-bottom: 0.5em;
  }

  p {
    color: #5F6F78;
  }
</style>
