---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout bodyClass="contact" title="Page Not Found | Corilla">
  <section id="intro">
    <div class="section-content">
      <div class="intro-text">
        <h1>404</h1>
        <h2>Page not found</h2>
        <p>Sorry, we couldn't find what you're looking for. Head back to the <a href="/">homepage</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #intro {
    padding: 8em 0;
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-content {
    width: 85%;
    max-width: 1200px;
    margin: auto;
  }

  .intro-text {
    max-width: 700px;
    margin: auto;
  }

  h1 {
    font-size: 4rem;
    color: #F7D33A;
    padding-bottom: 0.2em;
  }

  h2 {
    padding-bottom: 1em;
  }

  a {
    color: #0B2C3E;
    box-shadow: 0 2px 0 #0B2C3E;
  }

  a:hover {
    color: #F7D33A;
    box-shadow: 0 2px 0 #F7D33A;
  }
</style>
