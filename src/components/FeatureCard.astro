---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div class="feature">
  <div class="number">{number}</div>
  <h3 class="feature-title">{title}</h3>
  <p>{description}</p>
</div>

<style>
  .feature {
    text-align: left;
    width: 19em;
    padding-bottom: 4em;
    margin-left: 4em;
  }

  @media screen and (max-width: 820px) {
    .feature {
      width: 100%;
    }
  }

  .number {
    color: #8B7500;
  }

  .feature-title {
    font-size: 1.25rem;
    padding-bottom: 1em;
  }

  p {
    color: #5F6F78;
  }
</style>
