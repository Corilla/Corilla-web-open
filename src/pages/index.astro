---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import SocialProof from '../components/SocialProof.astro';
import HowTopicsWork from '../components/HowTopicsWork.astro';
import BentoGrid from '../components/BentoGrid.astro';
import WistiaVideo from '../components/WistiaVideo.astro';
import PricingToggle from '../components/PricingToggle.astro';
import productMockup from '../assets/img/product-mockup.png';
---

<BaseLayout bodyClass="home" headerVariant="home">
  <!-- Hero Section -->
  <section id="hero">
    <div class="section-content">
      <div class="intro">
        <div class="intro-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>MODULAR DOCS-AS-CODE</span>
          </div>
          <h1>Topic-based authoring without the XML complexity.</h1>
          <p class="hero-subhead">
            Leave copy-paste documentation behind. Corilla pairs topic-based single-sourcing with pre-built in-templates so technical teams can write, reuse, and publish modular docs at scale—in clean Markdown.
          </p>
          <div class="hero-cta-group">
            <a class="button button-primary" href="https://app.corilla.com/register">
              Start Writing with Templates <span class="arrow">⟶</span>
            </a>
            <a class="button button-secondary" href="#how-it-works">
              How Topics Work <span class="arrow">↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Hero Product Preview -->
      <div class="mockup-frame">
        <Image
          src={productMockup}
          alt="Corilla topic-based editor and publishing mockup"
          widths={[500, 700, 1002, productMockup.width]}
          sizes="(max-width: 800px) 95vw, 850px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Social Proof Ribbon -->
  <SocialProof />

  <!-- How Topic-Based Authoring Works -->
  <HowTopicsWork />

  <!-- Bento Grid Features (In-Templates, Single-Sourcing, Versioning) -->
  <BentoGrid />

  <!-- Video Walkthrough -->
  <WistiaVideo />

  <!-- Pricing & Plans -->
  <PricingToggle />

  <!-- Final Bottom Call to Action -->
  <section id="marketing">
    <div class="section-content">
      <h2>Start writing more good*</h2>
      <p>We bring the modular workflow (*but you'll still need the amazing grammar).</p>
      <a class="button button-primary" href="https://app.corilla.com/register">
        Sign up for free <span class="arrow">⟶</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home :global(.header-placeholder),
  .home :global(header) {
    background: #fdfefe;
  }

  /* Base Button System */
  .button {
    font-family: 'Sailec-Medium', 'HelveticaNeue', Helvetica, Arial, sans-serif;
    font-size: 1.125rem;
    padding: 0.65em 1.35em;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .button-primary {
    background: #F7D33A;
    color: #0B2C3E;
    box-shadow: 0 4px 12px rgba(247, 211, 58, 0.35);
  }

  .button-primary:hover {
    background: #0B2C3E;
    color: #FFFFFF;
    box-shadow: 0 6px 16px rgba(11, 44, 62, 0.2);
    transform: translateY(-2px);
  }

  .button-secondary {
    background: #FFFFFF;
    color: #0B2C3E;
    border: 1px solid #D4D8DD;
    box-shadow: 0 2px 4px rgba(11, 44, 62, 0.04);
  }

  .button-secondary:hover {
    border-color: #0B2C3E;
    background: #F6F7F8;
    transform: translateY(-2px);
  }

  .arrow {
    margin-left: 0.4em;
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .button:hover .arrow {
    transform: translateX(3px);
  }

  /* Hero Section */
  #hero {
    text-align: center;
    background: linear-gradient(180deg, #fdfefe 0%, #f4f7f9 100%);
    padding-bottom: 5em;
  }

  #hero .intro {
    padding: 5em 1.5em 3em;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #E2E6EA;
    padding: 0.35em 0.9em;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0B2C3E;
    margin-bottom: 1.75em;
    box-shadow: 0 2px 6px rgba(11, 44, 62, 0.04);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #F7D33A;
  }

  #hero .intro-content h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: #0B2C3E;
    max-width: 820px;
    margin: 0 auto 0.5em;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-subhead {
    color: #5F6F78;
    font-size: clamp(1rem, 2vw, 1.25rem);
    max-width: 680px;
    margin: 0 auto 2.25em;
    line-height: 1.6;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    justify-content: center;
    margin-bottom: 2em;
  }

  .mockup-frame {
    max-width: 860px;
    margin: 0 auto;
    padding: 0.75em;
    background: #FFFFFF;
    border: 1px solid #D4D8DD;
    border-radius: 12px;
    box-shadow: 0 24px 48px -12px rgba(11, 44, 62, 0.12), 0 4px 16px rgba(11, 44, 62, 0.04);
  }

  .mockup-frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  .section-content {
    width: 90%;
    max-width: 1200px;
    margin: auto;
  }

  /* Marketing Section */
  #marketing {
    padding: 6em 1.5em;
    text-align: center;
    background: #FFFFFF;
    border-top: 1px solid #F0F2F4;
  }

  #marketing h2 {
    font-size: 2.25rem;
    color: #0B2C3E;
    padding-bottom: 0.3em;
  }

  #marketing p {
    color: #5F6F78;
    font-size: 1.125rem;
    padding-bottom: 2.5em;
    max-width: 550px;
    margin: 0 auto;
  }

  @media screen and (max-width: 640px) {
    #hero .intro {
      padding: 3em 1em 2em;
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
    }
    .hero-cta-group .button {
      width: 100%;
    }
  }
</style>
