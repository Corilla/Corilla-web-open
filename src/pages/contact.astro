---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout bodyClass="contact">
  <section id="intro">
    <div class="section-content">
      <div class="intro-text">
        <h2>Contact Corilla</h2>
        <p>We love talking about technical writing, content, and open source. If you do too, get in touch and let us know how we can help.</p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  #intro {
    padding: 8em 0;
    text-align: center;
  }

  .section-content {
    width: 85%;
    max-width: 1200px;
    margin: auto;
  }

  .intro-text {
    padding-bottom: 4em;
    max-width: 700px;
    margin: auto;
  }

  .intro-text h2 {
    padding-bottom: 0.3em;
  }
</style>
